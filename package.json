{
  "name": "sillytavern-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:baseline": "python3 scripts/prepare.py",
    "start": "docker compose up -d --wait",
    "stop": "docker compose down",
    "local:prepare": "node scripts/local-runtime.mjs prepare",
    "local:start": "node scripts/local-runtime.mjs start",
    "deploy": "node scripts/deploy.mjs",
    "local:stop": "node scripts/local-runtime.mjs stop",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "npm run typecheck && tsc --noEmit -p server/workbench-sync && tsc --noEmit -p ide/vscode && node --check extension/trace.js && node --check extension/startup.js && node --check fixtures/mock-model.mjs",
    "build": "node scripts/build.mjs && node scripts/build-sync.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit",
    "verify:workbench": "node scripts/verify-workbench.mjs",
    "verify:compat": "node scripts/verify-workbench-compat.mjs",
    "benchmark:chat": "node scripts/benchmark-chat.mjs",
    "benchmark:hotpaths": "node scripts/benchmark-hotpaths.mjs",
    "verify:home": "node scripts/verify-home-implementation.mjs",
    "verify:resources": "node scripts/verify-resource-sidebars.mjs",
    "verify:interactions": "node scripts/verify-interactions-runtime.mjs",
    "verify:fidelity": "node scripts/verify-design-fidelity.mjs",
    "review:fidelity": "node scripts/build-design-review.mjs",
    "verify:migration": "node scripts/verify-migration-runtime.mjs",
    "verify:motion": "node scripts/verify-motion-layout.mjs",
    "verify:click-motion": "node scripts/verify-click-motion.mjs",
    "verify:preferences": "node scripts/verify-preferences-runtime.mjs",
    "verify:rp": "node scripts/verify-rp-runtime.mjs",
    "verify:database": "node scripts/verify-database-runtime.mjs",
    "verify:database-real": "node scripts/verify-database-real.mjs",
    "verify:sync": "node scripts/verify-sync.mjs",
    "verify:addons": "node scripts/verify-addons.mjs",
    "verify:utilities": "node scripts/verify-utility-tools.mjs",
    "verify:placeholders": "node scripts/verify-placeholders.mjs",
    "benchmark:startup": "node scripts/benchmark-startup-readonly.mjs",
    "verify:writing-addons": "node scripts/verify-writing-addons.mjs",
    "verify:pwa": "node scripts/verify-pwa-runtime.mjs",
    "verify:edge": "node scripts/verify-edge-lane.mjs",
    "verify:layout-controls": "node scripts/verify-layout-controls.mjs",
    "verify:stale": "node scripts/verify-stale-chunk.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "verify:styles": "npm run build && node scripts/visual/computed.mjs snap artifacts/visual/check && node scripts/visual/computed.mjs diff ${WB_STYLE_BASELINE:-artifacts/baseline-c6/computed} artifacts/visual/check"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/vscode": "1.140.0",
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/markdown": "1.8.0",
    "fflate": "0.8.2",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "yaml": "2.9.1"
  }
}
